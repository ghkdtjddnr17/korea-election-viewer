# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch / local-only — not for commit
# Playwright MCP snapshots / console logs / screenshots (auto-regenerated)
.playwright-mcp/
# 디자인 시안 HTML + 영감 스크린샷 (탐색물 — 실제 컴포넌트로 구현 완료)
/design-mocks/

# editor / IDE
.vscode/
.idea/
*.swp
*~

# OS
Thumbs.db

# build diagnostic — regenerated by `pnpm build:data`, not used by the app
/data/verify.json
